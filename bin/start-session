#!/usr/bin/env bash
#
# Start a Claude Code session with Remote Control enabled, in a project
# directory, inside a detached tmux session so it outlives the caller.
#
# usage: start-session <project>[/<persona>] [session-id]
#
# With a persona, the session starts in that subfolder of the project, so
# Claude loads its CLAUDE.md on top of the project's. With a session id,
# resumes that conversation instead of starting a new one.

set -euo pipefail

PROJECTS_DIR=/root/github

if [ $# -lt 1 ] || [ $# -gt 2 ]; then
  echo "usage: start-session <project>[/<persona>] [session-id]" >&2
  exit 2
fi

TARGET=$1
SESSION_ID=${2:-}

NAME=${TARGET%%/*}
PERSONA=
[ "$TARGET" = "$NAME" ] || PERSONA=${TARGET#*/}

# Called from a web app, so treat every argument as untrusted. They end up in
# a path and in the tmux command string; reject anything that could escape
# either. Each part is checked on its own, so a persona containing another
# slash fails the same rule.
valid_name() {
  case $1 in
    "" | .* | *[!A-Za-z0-9._-]*) return 1 ;;
  esac
}

if ! valid_name "$NAME"; then
  echo "invalid project name: $NAME" >&2
  exit 2
fi
if [ "$TARGET" != "$NAME" ] && ! valid_name "$PERSONA"; then
  echo "invalid persona: $PERSONA" >&2
  exit 2
fi

case $SESSION_ID in
  "") ;;
  *[!a-fA-F0-9-]*)
    echo "invalid session id: $SESSION_ID" >&2
    exit 2
    ;;
esac

DIR="$PROJECTS_DIR/$NAME${PERSONA:+/$PERSONA}"

if [ ! -d "$DIR" ]; then
  echo "no such project: $DIR" >&2
  exit 1
fi

# Claude blocks on interactive prompts that a detached session can never
# answer: first-run onboarding, "do you trust this folder?" for a directory it
# hasn't seen, and approval for a CLAUDE.md that imports a file from outside
# the folder, which is how a persona reaches a memory file its siblings share.
# Any of them leaves a session that looks alive in the Claude app and does
# nothing. Answer them up front. Approving imports asks nothing more of a
# project than trusting it already does.
#
# ponytail: last writer wins if Claude rewrites .claude.json at the same moment.
# Serialise with flock if that ever actually bites.
CONFIG="$HOME/.claude.json"
mkdir -p "$HOME/.claude"
[ -e "$CONFIG" ] || echo '{"hasCompletedOnboarding":true}' > "$CONFIG"
[ -e "$HOME/.claude/settings.json" ] || echo '{"theme":"dark"}' > "$HOME/.claude/settings.json"

TMP=$(mktemp)
jq --arg dir "$DIR" \
  '.hasCompletedOnboarding = true
   | .projects[$dir].hasTrustDialogAccepted = true
   | .projects[$dir].hasClaudeMdExternalIncludesApproved = true
   | .projects[$dir].hasClaudeMdExternalIncludesWarningShown = true' \
  "$CONFIG" > "$TMP" && mv "$TMP" "$CONFIG"

if [ -n "$SESSION_ID" ]; then
  # --resume treats an unrecognised value as a search term and opens the
  # interactive picker, which in a detached session means a live-looking
  # session that never responds. Fail here instead.
  TRANSCRIPT="$HOME/.claude/projects/$(printf '%s' "$DIR" | tr '/' '-')/$SESSION_ID.jsonl"
  if [ ! -f "$TRANSCRIPT" ]; then
    echo "no such session for $TARGET: $SESSION_ID" >&2
    exit 1
  fi
fi

# tmux session names must be unique. Suffix if the base name is taken, so
# names read as myproject, myproject-2, myproject-3.
# The = prefix forces an exact match; without it tmux matches on prefix and
# "myproject" would find "myproject-2". A persona joins the name with a dash,
# so the Claude app lists life-advisors-trainer rather than a bare project.
BASE=$NAME${PERSONA:+-$PERSONA}
SESSION=$BASE
if tmux has-session -t "=$SESSION" 2>/dev/null; then
  n=2
  while tmux has-session -t "=$BASE-$n" 2>/dev/null; do
    n=$((n + 1))
  done
  SESSION="$BASE-$n"
fi

if [ -n "$SESSION_ID" ]; then
  CMD="claude --resume '$SESSION_ID' --remote-control '$SESSION'"
else
  CMD="claude --remote-control '$SESSION'"
fi

tmux new-session -d -s "$SESSION" -c "$DIR" "$CMD"

echo "started $SESSION in $DIR"
